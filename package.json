{
  "name": "silver-smart",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsc -p tsconfig.server.json && node --env-file-if-exists=.env dist-server/index.js",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.48.0",
    "nodemailer": "^10.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=22"
  }
}
