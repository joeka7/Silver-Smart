# Copy to .env for local development and fill in the blanks.
# On Railway, set these as service variables instead — .env is never deployed.
# Only VITE_* values reach the browser; everything else stays on the server.

# ── SMTP (server only) ──
SMTP_HOST=mail.everlastwellness.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@everlastwellness.com
SMTP_PASS=GqWVw2vnoNkh

# Contact form recipient (server only)
CONTACT_RECEIVER_EMAIL=customer.service@everlastwellness.com

# ── Cloudflare Turnstile ──
# The site key is public and is built into the browser bundle.
# The secret key is server only — never give it a VITE_ prefix.
# Cloudflare's always-pass test keys for local work:
#   site 1x00000000000000000000AA · secret 1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── CORS ──
# Leave blank: the site and the API are served from the same origin.
# Only set this (comma-separated origins, never *) if another site must post to /api/contact.
CONTACT_ALLOWED_ORIGIN=

# ── Bot protection ──
# Local testing only. Turnstile is bypassed only when BOTH are true,
# and the bypass is ignored in production builds and on the production server.
CONTACT_DISABLE_TURNSTILE=false
VITE_DISABLE_TURNSTILE=false
